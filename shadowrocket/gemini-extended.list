# NAME: Gemini Extended
# UPDATED: 2026-11-26
#
# Load with gemini.list for OAuth, web assets, Antigravity updates,
# and enterprise model and search APIs. Also load google-shared.list
# for Google sign-in and Cloud Storage downloads.
# Other Google products using these hosts will follow the same policy.
#
# SOURCES:
# https://knowledge.workspace.google.com/admin/generative-ai/gemini-app/gemini-app-firewall-settings
# https://docs.cloud.google.com/gemini/docs/codeassist/code-overview
# https://antigravity.google/download
# https://antigravity.google/docs/enterprise/
# https://docs.cloud.google.com/docs/security/compliance/deploy-antigravity-us-public-sector
# https://docs.cloud.google.com/vertex-ai/docs/reference/rest#service-endpoint
# https://support.google.com/g/answer/16547037
# https://docs.cloud.google.com/gemini/enterprise/docs/release-notes
# https://docs.cloud.google.com/gemini/enterprise/docs/private-ui-access
# https://docs.cloud.google.com/iam/docs/best-practices-workforce-identity-federation
# https://github.com/jgunnink/antigravity-updater#how-it-works
# https://github.com/etrnkz/gemini-unofficial-api/blob/main/docs/protocol.md
# https://support.google.com/gemini/thread/407841596
#
# DOMAIN: 100
# DOMAIN-SUFFIX: 1
# TOTAL: 101

# Google OAuth
DOMAIN,oauth2.googleapis.com

# Shared account and payment services used by Gemini Enterprise
DOMAIN,accounts.googleapis.com
DOMAIN,payments.cloud.google

# Shared scripts, fonts, images and Google API requests from the Gemini web app
DOMAIN,apis.google.com
DOMAIN,fonts.googleapis.com
DOMAIN,fonts.gstatic.com
DOMAIN,lh3.googleusercontent.com
DOMAIN,lh5.googleusercontent.com
DOMAIN,ogs.google.com
DOMAIN,ssl.gstatic.com
DOMAIN,waa-pa.clients6.google.com
DOMAIN,www.googleapis.com
DOMAIN,www.gstatic.com

# Shared image and thumbnail hosts listed in the Gemini App firewall settings
DOMAIN,lh3.google.com
DOMAIN,encrypted-tbn0.gstatic.com
DOMAIN,encrypted-tbn1.gstatic.com
DOMAIN,encrypted-tbn2.gstatic.com
DOMAIN,encrypted-tbn3.gstatic.com

# Gemini attachment uploads and per-preview Canvas hosts
DOMAIN,content-push.googleapis.com
DOMAIN-SUFFIX,scf.usercontent.goog

# Antigravity App, CLI and standalone IDE update checks and downloads
DOMAIN,antigravity-cli-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-hub-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-ide-auto-updater-974169037036.us-central1.run.app
DOMAIN,edgedl.me.gvt1.com

